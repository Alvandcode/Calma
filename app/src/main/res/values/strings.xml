    <!-- ============ Quick calm ============ -->
    <string name="calm_title">Calm now</string>
    <string name="calm_subtitle">Choose what fits this moment.</string>
    <string name="calm_suggested_for_you">Suggested for you</string>
    <string name="calm_start">Begin</string>
    <string name="calm_next">Next</string>
    <string name="calm_finish">Finish</string>
    <string name="calm_step_of">Step %1$d of %2$d</string>
    <string name="calm_disclaimer">Calma offers general relaxation exercises. It is not a substitute for professional mental-health care.</string>

    <string name="calm_breathe_title">Slow breathing</string>
    <string name="calm_breathe_sub">Follow a gentle 4–6 rhythm</string>
    <string name="calm_senses_title">Notice your five senses</string>
    <string name="calm_senses_sub">A slow scan of what is around you</string>
    <string name="calm_surroundings_title">Look around</string>
    <string name="calm_surroundings_sub">Find three things without naming them</string>
    <string name="calm_mindful_title">Be here now</string>
    <string name="calm_mindful_sub">Return gently to this moment</string>
    <string name="calm_release_title">Let thoughts pass</string>
    <string name="calm_release_sub">Notice, name, and let go</string>

    <string name="calm_step_senses_1">What do you see?</string>
    <string name="calm_step_senses_2">What do you hear?</string>
    <string name="calm_step_senses_3">What can you feel on your skin?</string>
    <string name="calm_step_senses_4">What can you smell, or is there no scent?</string>
    <string name="calm_step_senses_5">What can you taste?</string>
    <string name="calm_step_senses_6">Take one easy breath and finish.</string>
    <string name="calm_step_surround_1">Find three things you can see, without naming them.</string>
    <string name="calm_step_surround_2">Find two things you could touch if you wanted to.</string>
    <string name="calm_step_surround_3">Find one sound that is close to you.</string>
    <string name="calm_step_surround_4">Notice where your body meets the chair or the floor.</string>
    <string name="calm_step_surround_5">Rest here for a moment longer.</string>
    <string name="calm_step_mindful_1">Bring your attention to the breath, wherever you feel it.</string>
    <string name="calm_step_mindful_2">Follow one full breath from start to end.</string>
    <string name="calm_step_mindful_3">If your attention wanders, that is normal. Bring it back gently.</string>
    <string name="calm_step_mindful_4">Notice the feeling in your body right now, without changing it.</string>
    <string name="calm_step_mindful_5">Rest your attention here. You are exactly where you are.</string>
    <string name="calm_step_release_1">Notice a thought that is here.</string>
    <string name="calm_step_release_2">Name it quietly: thinking, planning, worrying.</string>
    <string name="calm_step_release_3">You do not have to solve it.</string>
    <string name="calm_step_release_4">Let it move on like weather.</string>
    <string name="calm_step_release_5">Come back to the weight of your body.</string>

