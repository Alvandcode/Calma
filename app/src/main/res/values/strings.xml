    <string name="settings_about_title">Calma</string>
    <string name="settings_about_body">Calma is a free and open-source Android app for focus, relaxation and mindfulness. It works fully offline, asks for no account, and contains no ads or trackers.</string>

    <string name="settings_help_title">User guide</string>
    <string name="settings_help_focus_title">Focus timer</string>
    <string name="settings_help_focus_body">Pick a length and start. The timer keeps correct time even if you switch apps or the screen rebuilds. When a session ends you are notified if notifications are enabled.</string>
    <string name="settings_help_breathe_title">Breathing</string>
    <string name="settings_help_breathe_body">Choose a gentle pattern and follow the circle. You can pause or end the exercise at any moment.</string>
    <string name="settings_help_sounds_title">Sound mixer</string>
    <string name="settings_help_sounds_body">Layer up to four ambient sounds and set each volume separately. Save a mix to reuse it later, or set a sleep timer.</string>
    <string name="settings_help_mood_title">Daily check-in</string>
    <string name="settings_help_mood_body">Record mood, stress, energy and concentration in a few seconds. Entries and notes never leave your device.</string>
    <string name="settings_help_stats_title">Progress</string>
    <string name="settings_help_stats_body">See how much time you focused and how your mood changed. All values are calculated on-device from your own records.</string>

    <!-- ============ Permissions screen ============ -->
    <string name="permissions_title">Permissions</string>
    <string name="permissions_intro">Calma asks for as little as possible. Every permission below is optional and can be denied without breaking the app.</string>
    <string name="permissions_notifications_title">Notifications</string>
    <string name="permissions_notifications_body">Shows a timer notification while a focus session runs, and tells you when a session ends. Denying this does not stop the timer itself.</string>
    <string name="permissions_vibrate_title">Vibration</string>
    <string name="permissions_vibrate_body">A short, soft vibration marks each breathing phase change.</string>
    <string name="permissions_foreground_title">Background audio</string>
    <string name="permissions_foreground_body">Allows ambient sounds to keep playing while you use another app. Android requires this to be shown as an ongoing notification.</string>
    <string name="permissions_wakelock_title">Keep screen awake</string>
    <string name="permissions_wakelock_body">Prevents the screen from turning off during a focus or breathing session that you started in the app.</string>
    <string name="permissions_none_title">No other permissions</string>
    <string name="permissions_none_body">Calma does not request internet access, camera, microphone, contacts, location or storage. It has no way to upload your data.</string>

