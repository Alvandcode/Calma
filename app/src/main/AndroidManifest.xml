<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Permissions in Calma
        =====================
        POST_NOTIFICATIONS (API 33+)   : shows the ambient-audio playback notification and the
                                       focus-session reminder. Requested at runtime, only when the
                                       user enables the relevant setting.
        VIBRATE                         : optional haptic cue at breathing phase changes. Requested
                                       at runtime, only when haptics are enabled.
        FOREGROUND_SERVICE              : required to keep ambient audio playing while Calma is not
                                       in the foreground (Android 9+ enforcement).
        FOREGROUND_SERVICE_MEDIA_PLAYBACK: API 34+ requires an explicit foreground-service type.
        WAKE_LOCK                       : keeps the CPU awake during an in-progress breathing or
                                       focus session so the screen does not sleep mid-exercise.

        There is deliberately NO INTERNET permission: Calma is fully offline and cannot
        transmit data, because it has no permission to do so.
    -->

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        tools:node="remove" />

    <application
        android:name=".CalmaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Calma">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|smallestScreenSize|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Calma"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".audio.AmbientPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>